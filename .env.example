# ========================================================
# LabelGuard AI — Environment Configuration Example
# ========================================================

# Supabase Credentials (for Legal Metrology Rules DB)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-anon-key"

# Database Connection (defaults to local SQLite fallback if unset)
DATABASE_URL="sqlite:///./labelguard.db"

# Optional AI Detector Model (Deep Learning Vision Transformer)
LABELGUARD_AI_DETECTOR_MODEL="umm-maybe/AI-image-detector"

# Server Settings
HOST="0.0.0.0"
PORT=8000
